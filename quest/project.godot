; Engine configuration file.
config_version=5

[application]

config/name="Vexley MR"
config/description="Vexley, a shimeji-style fox companion who explores your real room on Meta Quest."
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.4", "Mobile")
config/icon="res://icon.png"

[display]

window/vsync/vsync_mode=0

[rendering]

renderer/rendering_method="mobile"
textures/vram_compression/import_etc2_astc=true
anti_aliasing/quality/msaa_3d=2

[xr]

openxr/enabled=true
openxr/reference_space=1
openxr/environment_blend_mode=2
openxr/foveation_level=3
openxr/foveation_dynamic=true
openxr/extensions/hand_tracking=true
shaders/enabled=true
